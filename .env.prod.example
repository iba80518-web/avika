# Copier en .env.prod puis remplir. Ce fichier-ci ne contient aucun secret.
# Générer une clé : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 0 pour tester en http://localhost ; 1 (obligatoire) sur un vrai serveur en HTTPS
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=3600

POSTGRES_DB=avika
POSTGRES_USER=avika
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
